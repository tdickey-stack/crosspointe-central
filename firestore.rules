rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Promotion Planner Data Model
    // ===============================================================
    // centralPromotionPlaybooks/{playbookId}: required schema/version
    // metadata, level, name, campaign type, duration, active state,
    // description, updater UID, and immutable creation timestamp.
    // centralPromotionPlaybookVersions/{playbookId}_v{version}: immutable
    // playbook snapshot with the editable week/play definition array.
    // centralPromotionCampaigns/{campaignId}: event and submission timestamps,
    // stored timeliness, immutable playbook/version reference, notes, status,
    // creator/updater UIDs, and timestamps.
    // centralPromotionScheduledPlays/{playId}: independent original/current
    // schedule timestamps, campaign/playbook references, status, late/conflict
    // handling, manual/lock flags, optional Smuggle relationship, UIDs, and
    // timestamps.
    // centralPromotionCapacityRules/{ruleId}: editable typical and hard resource
    // capacity, period, weekdays, eligible levels, allocation strategy, and
    // timestamps. Typical capacity must not exceed the hard capacity.
    // centralPromotionStandingLanes/{laneId}: editable weekly lane fallback,
    // priority order, Smuggle levels, active state, and timestamps.
    // centralPromotionRequests/{pco_formId_submissionId}: server-created,
    // idempotent Planning Center form request containing campaign-only source
    // answers, parsed/manual event-date review state, immutable source identity,
    // and an editor-controlled conversion or dismissal outcome.

    // ===============================================================
    // Studio event project source model
    // ===============================================================
    // centralStudioProjects/{projectId} schemaVersion 1 event and social
    // projects retain their strict creative-content schema. sourceType is
    // required.
    // Legacy manual projects may omit sourceId, sourceEventId, sourceUrl, and
    // sourceUpdatedAt. New manual projects store empty strings plus null.
    // Planning Center projects require numeric instance/event IDs, an optional
    // public HTTPS URL, and a timestamp for the last explicit import/refresh.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/centralAdmin/root/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function currentUser() {
      return get(userDocPath());
    }

    function isActiveAdminUser() {
      return hasUserDoc() && currentUser().data.active == true;
    }

    function hasAdminSectionAccess() {
      return isActiveAdminUser() && (
        isAdminLevel(currentUser().data.pageAccess.users) ||
        isAdminLevel(currentUser().data.pageAccess.roles) ||
        isAdminLevel(currentUser().data.pageAccess.changeRequests) ||
        isAdminLevel(currentUser().data.pageAccess.settings)
      );
    }

    function isAdminLevel(permission) {
      return permission == "approve" || permission == "admin";
    }

    function isEditorLevel(permission) {
      return permission == "edit" ||
        permission == "approve" ||
        permission == "admin";
    }

    function hasAnySectionAccess(permission) {
      return permission == "view" ||
        permission == "propose" ||
        permission == "edit" ||
        permission == "approve" ||
        permission == "admin";
    }

    // Studio projects contain creative content only. Account identity remains
    // in centralAdmin, while ownership and server-issued memberships control
    // access to each project.
    function studioPermission() {
      return currentUser().data.pageAccess.studio != null ?
        currentUser().data.pageAccess.studio :
        currentUser().data.pageAccess.settings;
    }

    function canUseStudio() {
      return isActiveAdminUser() && hasAnySectionAccess(studioPermission());
    }

    function canEditStudio() {
      return isActiveAdminUser() && (
        studioPermission() == "propose" ||
        isEditorLevel(studioPermission())
      );
    }

    function canManageStudioLogoLibrary() {
      return isActiveAdminUser() &&
        currentUser().data.pageAccess.studio == "admin";
    }

    function studioMembershipPath(projectId) {
      return /databases/$(database)/documents/centralStudioMemberships/$(request.auth.uid + "_" + projectId);
    }

    function hasStudioMembership(projectId) {
      return canUseStudio() &&
        exists(studioMembershipPath(projectId)) &&
        get(studioMembershipPath(projectId)).data.memberUid == request.auth.uid &&
        get(studioMembershipPath(projectId)).data.projectId == projectId &&
        get(studioMembershipPath(projectId)).data.permission == "edit";
    }

    function canReadStudioProject(projectId, data) {
      return canUseStudio() && (
        data.ownerUid == request.auth.uid ||
        hasStudioMembership(projectId)
      );
    }

    function canEditStudioProject(projectId, data) {
      return canEditStudio() && (
        data.ownerUid == request.auth.uid ||
        hasStudioMembership(projectId)
      );
    }

    function validStudioString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validStudioLogoId(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 80 &&
        value.matches("^[A-Za-z0-9_-]+$");
    }

    function validStudioLogo(data, logoId) {
      return data is map &&
        validStudioLogoId(logoId) &&
        data.keys().hasAll([
          "schemaVersion", "name", "storagePath", "contentType", "status",
          "createdByUid", "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "name", "storagePath", "contentType", "status",
          "createdByUid", "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 1 &&
        validStudioString(data.name, 80) && data.name.size() > 0 &&
        data.storagePath.matches(
          "^studio-library/logos/" + logoId +
          "/source[.](jpg|png|webp)$"
        ) &&
        data.contentType in ["image/jpeg", "image/png", "image/webp"] &&
        data.status in ["active", "archived"] &&
        validStudioString(data.createdByUid, 128) &&
        data.createdByUid.size() > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validStudioProjectId(projectId) {
      return projectId is string &&
        projectId.size() > 0 &&
        projectId.size() <= 128 &&
        projectId.matches("^[A-Za-z0-9_-]+$");
    }

    function validStudioHttpsUrl(value, maximum) {
      return validStudioString(value, maximum) &&
        (value.size() == 0 || value.matches("^https://.*"));
    }

    function validPolicyContent(content) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "operatingRuleLabel", "operatingRule", "primarySectionLabel",
          "primarySectionTitle", "primaryItemsText", "secondarySectionLabel",
          "secondarySectionTitle", "secondaryItemsText", "ownerLabel",
          "ownerTitle", "ownerItemsText", "processLabel", "processStepsText",
          "footerNote", "footerReference", "accent"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "operatingRuleLabel", "operatingRule", "primarySectionLabel",
          "primarySectionTitle", "primaryItemsText", "secondarySectionLabel",
          "secondarySectionTitle", "secondaryItemsText", "ownerLabel",
          "ownerTitle", "ownerItemsText", "processLabel", "processStepsText",
          "footerNote", "footerReference", "accent"
        ]) &&
        validStudioString(content.eyebrow, 52) &&
        validStudioString(content.audience, 28) &&
        validStudioString(content.documentNumber, 18) &&
        validStudioString(content.title, 72) &&
        validStudioString(content.subtitle, 150) &&
        validStudioString(content.operatingRuleLabel, 32) &&
        validStudioString(content.operatingRule, 320) &&
        validStudioString(content.primarySectionLabel, 32) &&
        validStudioString(content.primarySectionTitle, 38) &&
        validStudioString(content.primaryItemsText, 700) &&
        validStudioString(content.secondarySectionLabel, 32) &&
        validStudioString(content.secondarySectionTitle, 38) &&
        validStudioString(content.secondaryItemsText, 700) &&
        validStudioString(content.ownerLabel, 32) &&
        validStudioString(content.ownerTitle, 38) &&
        validStudioString(content.ownerItemsText, 480) &&
        validStudioString(content.processLabel, 30) &&
        validStudioString(content.processStepsText, 240) &&
        validStudioString(content.footerNote, 500) &&
        validStudioString(content.footerReference, 34) &&
        content.accent == "red";
    }

    function validChecklistContent(content) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "instructionsLabel", "instructions", "sectionOneTitle",
          "sectionOneItemsText", "sectionTwoTitle", "sectionTwoItemsText",
          "sectionThreeTitle", "sectionThreeItemsText", "calloutLabel",
          "calloutText", "footerNote", "footerReference", "accent"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "instructionsLabel", "instructions", "sectionOneTitle",
          "sectionOneItemsText", "sectionTwoTitle", "sectionTwoItemsText",
          "sectionThreeTitle", "sectionThreeItemsText", "calloutLabel",
          "calloutText", "footerNote", "footerReference", "accent"
        ]) &&
        validStudioString(content.eyebrow, 52) &&
        validStudioString(content.audience, 28) &&
        validStudioString(content.documentNumber, 18) &&
        validStudioString(content.title, 72) &&
        validStudioString(content.subtitle, 220) &&
        validStudioString(content.instructionsLabel, 32) &&
        validStudioString(content.instructions, 360) &&
        validStudioString(content.sectionOneTitle, 36) &&
        validStudioString(content.sectionOneItemsText, 1400) &&
        validStudioString(content.sectionTwoTitle, 36) &&
        validStudioString(content.sectionTwoItemsText, 1400) &&
        validStudioString(content.sectionThreeTitle, 36) &&
        validStudioString(content.sectionThreeItemsText, 1400) &&
        validStudioString(content.calloutLabel, 32) &&
        validStudioString(content.calloutText, 360) &&
        validStudioString(content.footerNote, 500) &&
        validStudioString(content.footerReference, 40) &&
        content.accent == "red";
    }

    function validContentBlock(block) {
      return block is map &&
        block.keys().hasAll(["id", "type", "text"]) &&
        block.keys().hasOnly(["id", "type", "text"]) &&
        validStudioString(block.id, 80) && block.id.size() > 0 &&
        block.type in [
          "heading", "paragraph", "bullets", "numbered", "callout", "divider"
        ] &&
        validStudioString(block.text, 1200);
    }

    function validContentBlocks(blocks) {
      return blocks is list && blocks.size() <= 8 &&
        (blocks.size() < 1 || validContentBlock(blocks[0])) &&
        (blocks.size() < 2 || validContentBlock(blocks[1])) &&
        (blocks.size() < 3 || validContentBlock(blocks[2])) &&
        (blocks.size() < 4 || validContentBlock(blocks[3])) &&
        (blocks.size() < 5 || validContentBlock(blocks[4])) &&
        (blocks.size() < 6 || validContentBlock(blocks[5])) &&
        (blocks.size() < 7 || validContentBlock(blocks[6])) &&
        (blocks.size() < 8 || validContentBlock(blocks[7]));
    }

    function validContentPageContent(content) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "blocks", "footerNote", "footerReference", "accent"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "blocks", "footerNote", "footerReference", "accent"
        ]) &&
        validStudioString(content.eyebrow, 52) &&
        validStudioString(content.audience, 28) &&
        validStudioString(content.documentNumber, 18) &&
        validStudioString(content.title, 72) &&
        validStudioString(content.subtitle, 220) &&
        validContentBlocks(content.blocks) &&
        validStudioString(content.footerNote, 500) &&
        validStudioString(content.footerReference, 40) &&
        content.accent == "red";
    }

    function validSignupSheetContent(content) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "instructionsLabel", "instructions", "signupCount",
          "columnOneLabel", "columnTwoLabel", "columnThreeLabel", "showNumbers",
          "footerNote", "footerReference", "accent"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "instructionsLabel", "instructions", "signupCount",
          "columnOneLabel", "columnTwoLabel", "columnThreeLabel", "showNumbers",
          "footerNote", "footerReference", "accent"
        ]) &&
        validStudioString(content.eyebrow, 52) &&
        validStudioString(content.audience, 28) &&
        validStudioString(content.documentNumber, 18) &&
        validStudioString(content.title, 72) &&
        validStudioString(content.subtitle, 220) &&
        validStudioString(content.instructionsLabel, 32) &&
        validStudioString(content.instructions, 360) &&
        content.signupCount is int &&
        content.signupCount >= 4 && content.signupCount <= 24 &&
        validStudioString(content.columnOneLabel, 28) &&
        validStudioString(content.columnTwoLabel, 28) &&
        validStudioString(content.columnThreeLabel, 28) &&
        content.showNumbers is bool &&
        validStudioString(content.footerNote, 500) &&
        validStudioString(content.footerReference, 40) &&
        content.accent == "red";
    }

    function validDirectoryCard(card, projectId) {
      return card is map &&
        card.keys().hasAll([
          "id", "name", "subtitle", "details", "imageUrl",
          "imageStoragePath", "sourceType", "sourceId", "publicUrl",
          "createdAt", "updatedAt"
        ]) &&
        card.keys().hasOnly([
          "id", "name", "subtitle", "details", "imageUrl",
          "imageStoragePath", "sourceType", "sourceId", "publicUrl",
          "createdAt", "updatedAt"
        ]) &&
        validStudioString(card.id, 80) && card.id.size() > 0 &&
        validStudioString(card.name, 80) &&
        validStudioString(card.subtitle, 100) &&
        validStudioString(card.details, 360) &&
        validStudioHttpsUrl(card.imageUrl, 1000) &&
        validStudioString(card.imageStoragePath, 500) &&
        (
          card.imageStoragePath.size() == 0 ||
          card.imageStoragePath.matches(
            "^studio-projects/" + projectId + "/[^/]+$"
          )
        ) &&
        card.sourceType in ["manual", "planning-center"] &&
        validStudioString(card.sourceId, 80) &&
        validStudioHttpsUrl(card.publicUrl, 500) &&
        card.createdAt is timestamp &&
        card.updatedAt is timestamp;
    }

    function validDirectoryCardId(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 80 &&
        value.matches("^[A-Za-z0-9_-]+$");
    }

    function validDirectoryCardOrder(cardOrder) {
      return cardOrder is list &&
        cardOrder.size() <= 8 &&
        cardOrder.toSet().size() == cardOrder.size() &&
        (cardOrder.size() < 1 || validDirectoryCardId(cardOrder[0])) &&
        (cardOrder.size() < 2 || validDirectoryCardId(cardOrder[1])) &&
        (cardOrder.size() < 3 || validDirectoryCardId(cardOrder[2])) &&
        (cardOrder.size() < 4 || validDirectoryCardId(cardOrder[3])) &&
        (cardOrder.size() < 5 || validDirectoryCardId(cardOrder[4])) &&
        (cardOrder.size() < 6 || validDirectoryCardId(cardOrder[5])) &&
        (cardOrder.size() < 7 || validDirectoryCardId(cardOrder[6])) &&
        (cardOrder.size() < 8 || validDirectoryCardId(cardOrder[7]));
    }

    function validDirectoryContent(content) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "cardOrder", "footerNote", "footerReference", "accent"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "cardOrder", "footerNote", "footerReference", "accent"
        ]) &&
        validStudioString(content.eyebrow, 52) &&
        validStudioString(content.audience, 28) &&
        validStudioString(content.documentNumber, 18) &&
        validStudioString(content.title, 72) &&
        validStudioString(content.subtitle, 220) &&
        validDirectoryCardOrder(content.cardOrder) &&
        validStudioString(content.footerNote, 500) &&
        validStudioString(content.footerReference, 40) &&
        content.accent == "red";
    }

    function validDocumentPage(data) {
      return data is map &&
        data.keys().hasAll([
          "schemaVersion", "templateId", "content", "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "templateId", "content", "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 1 &&
        data.templateId in [
          "document-one-pager", "document-checklist", "document-signup-sheet",
          "document-directory", "document-content-page"
        ] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (
          data.templateId == "document-one-pager" ?
            validPolicyContent(data.content) :
          data.templateId == "document-checklist" ?
            validChecklistContent(data.content) :
          data.templateId == "document-signup-sheet" ?
            validSignupSheetContent(data.content) :
          data.templateId == "document-directory" ?
            validDirectoryContent(data.content) :
            validContentPageContent(data.content)
        );
    }

    function validPageId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function validPageOrder(pageOrder) {
      return pageOrder is list &&
        pageOrder.size() > 0 && pageOrder.size() <= 20 &&
        pageOrder.toSet().size() == pageOrder.size() &&
        (pageOrder.size() < 1 || validPageId(pageOrder[0])) &&
        (pageOrder.size() < 2 || validPageId(pageOrder[1])) &&
        (pageOrder.size() < 3 || validPageId(pageOrder[2])) &&
        (pageOrder.size() < 4 || validPageId(pageOrder[3])) &&
        (pageOrder.size() < 5 || validPageId(pageOrder[4])) &&
        (pageOrder.size() < 6 || validPageId(pageOrder[5])) &&
        (pageOrder.size() < 7 || validPageId(pageOrder[6])) &&
        (pageOrder.size() < 8 || validPageId(pageOrder[7])) &&
        (pageOrder.size() < 9 || validPageId(pageOrder[8])) &&
        (pageOrder.size() < 10 || validPageId(pageOrder[9])) &&
        (pageOrder.size() < 11 || validPageId(pageOrder[10])) &&
        (pageOrder.size() < 12 || validPageId(pageOrder[11])) &&
        (pageOrder.size() < 13 || validPageId(pageOrder[12])) &&
        (pageOrder.size() < 14 || validPageId(pageOrder[13])) &&
        (pageOrder.size() < 15 || validPageId(pageOrder[14])) &&
        (pageOrder.size() < 16 || validPageId(pageOrder[15])) &&
        (pageOrder.size() < 17 || validPageId(pageOrder[16])) &&
        (pageOrder.size() < 18 || validPageId(pageOrder[17])) &&
        (pageOrder.size() < 19 || validPageId(pageOrder[18])) &&
        (pageOrder.size() < 20 || validPageId(pageOrder[19]));
    }

    function validDocumentSettings(settings) {
      return settings is map &&
        settings.keys().hasAll(["showPageNumbers"]) &&
        settings.keys().hasOnly(["showPageNumbers"]) &&
        settings.showPageNumbers is bool;
    }

    function isEventTemplateId(templateId) {
      return templateId.matches(
        "^(event-promotion|event-signal-stack|event-rally-poster|" +
        "event-future-block|event-center-stage|event-timeless-center|" +
        "event-editorial-invitation|event-scripted-welcome)$"
      );
    }

    function isSocialTemplateId(templateId) {
      return templateId.matches(
        "^(social-scripture|social-quote|social-statement|" +
        "social-simple-statement)$"
      );
    }

    function validEventComposition(templateId, composition) {
      return (templateId + ":" + composition).matches(
        "^(" +
        "(event-promotion|event-signal-stack):" +
        "(editorial|signal|split|color-overlay|flat)|" +
        "event-rally-poster:" +
        "(rally-stripes|rally-frame|editorial|color-overlay|flat)|" +
        "event-future-block:" +
        "(future-grid|future-cut|editorial|color-overlay|flat)|" +
        "event-center-stage:" +
        "(center-burst|center-frame|color-overlay|flat)|" +
        "event-timeless-center:" +
        "(serif-medallion|serif-lines|color-overlay|flat)|" +
        "event-editorial-invitation:" +
        "(editorial-flow|editorial-frame|editorial-column|" +
        "color-overlay|flat)|" +
        "event-scripted-welcome:" +
        "(welcome-halo|welcome-arch|welcome-ribbons|color-overlay|flat)|" +
        "document-small-group-leader:groups-gradient|" +
        "social-scripture:" +
        "(serif-lines|serif-medallion|color-overlay|flat)|" +
        "social-quote:" +
        "(editorial-frame|editorial-flow|color-overlay|flat)|" +
        "social-statement:" +
        "(center-burst|center-frame|color-overlay|flat)|" +
        "social-simple-statement:flat" +
        ")$"
      );
    }

    function validHeroReference(content, projectId) {
      return (
        (
          content.heroLogoSource == "" &&
          content.heroLogoLibraryId == "" &&
          content.heroLogoStoragePath == "" &&
          content.heroLogoName == ""
        ) ||
        (
          content.heroLogoSource == "upload" &&
          content.heroLogoLibraryId == "" &&
          content.heroLogoStoragePath.matches(
            "^studio-projects/" + projectId + "/[^/]+$"
          ) &&
          content.heroLogoName.size() > 0
        ) ||
        (
          content.heroLogoSource == "library" &&
          validStudioLogoId(content.heroLogoLibraryId) &&
          content.heroLogoStoragePath.matches(
            "^studio-library/logos/" + content.heroLogoLibraryId +
            "/source[.](jpg|png|webp)$"
          ) &&
          content.heroLogoName.size() > 0
        )
      );
    }

    function validGraphicKindFields(content, projectId, templateId) {
      return templateId == "document-small-group-leader" ? (
        content.title.matches("^.{0,52}$") &&
        content.format == "screen" &&
        validEventComposition(templateId, content.composition) &&
        content.heroMode == "text" &&
        content.heroLogoSource == "" &&
        content.heroLogoLibraryId == "" &&
        content.heroLogoStoragePath == "" &&
        content.heroLogoName == ""
      ) : isSocialTemplateId(templateId) ? (
        validStudioString(content.title, 220) &&
        content.date == "" &&
        content.time == "" &&
        content.location == "" &&
        content.format.matches("^(square|portrait)$") &&
        validEventComposition(templateId, content.composition) &&
        (
          templateId == "social-simple-statement" ?
            validHeroReference(content, projectId) :
            content.heroMode == "text" &&
            content.heroLogoSource == "" &&
            content.heroLogoLibraryId == "" &&
            content.heroLogoStoragePath == "" &&
            content.heroLogoName == ""
        )
      ) : (
        content.title.matches("^.{0,52}$") &&
        content.format.matches("^(square|portrait|screen)$") &&
        validEventComposition(templateId, content.composition) &&
        validHeroReference(content, projectId)
      );
    }

    function validEventContent(content, projectId, templateId) {
      return content is map &&
        content.keys().hasOnly([
          "eyebrow", "optionalTextVisibility", "title", "subtitle",
          "date", "time", "location", "cta",
          "format", "composition", "palette", "flatColor", "overlayColor",
          "overlayBlendMode", "focalX", "focalY",
          "imageZoom", "backgroundImageOpacity", "backgroundImageRotation",
          "backgroundImageSource", "backgroundImageUrl",
          "backgroundImageStoragePath", "unsplashPhotoId",
          "unsplashPhotographerName", "unsplashPhotographerUrl",
          "unsplashPhotoUrl", "heroMode", "heroLogoSource",
          "heroLogoLibraryId", "heroLogoStoragePath", "heroLogoName",
          "heroLogoScale", "heroLogoClearSpace",
          "fontKey", "fontWeight", "brandMark", "brandColor",
          "textAlignment", "textShadow"
        ]) &&
        content.eyebrow.matches("^.{0,30}$") &&
        content.optionalTextVisibility.matches(
          "^(both|eyebrow|subtitle|none)$"
        ) &&
        validStudioString(content.subtitle, 110) &&
        content.date.matches("^.{0,28}$") &&
        content.time.matches("^.{0,24}$") &&
        content.location.matches("^.{0,34}$") &&
        content.cta.matches("^.{0,44}$") &&
        validGraphicKindFields(content, projectId, templateId) &&
        content.palette.matches(
          "^(charcoal-red|warm-light|blue-charcoal|paper-red|sky-mint|" +
          "blush-burgundy)$"
        ) &&
        content.flatColor.matches(
          "^(red|cyan|charcoal|white|sky|purple|mint|burgundy|blush|cream)$"
        ) &&
        content.overlayColor.matches(
          "^(red|cyan|charcoal|white|sky|purple|mint|burgundy|blush|cream)$"
        ) &&
        content.overlayBlendMode.matches(
          "^(multiply|screen|overlay|soft-light)$"
        ) &&
        content.focalX >= 0 &&
        content.focalX <= 100 &&
        content.focalY >= 0 &&
        content.focalY <= 100 &&
        content.imageZoom >= 1 &&
        content.imageZoom <= 2 &&
        content.backgroundImageOpacity >= 0 &&
        content.backgroundImageOpacity <= 1 &&
        content.backgroundImageRotation >= 0 &&
        content.backgroundImageRotation <= 360 &&
        content.backgroundImageSource.matches("^(|upload|unsplash)$") &&
        validStudioString(content.backgroundImageUrl, 1600) &&
        validStudioString(content.backgroundImageStoragePath, 240) &&
        validStudioString(content.unsplashPhotoId, 80) &&
        validStudioString(content.unsplashPhotographerName, 120) &&
        validStudioString(content.unsplashPhotographerUrl, 800) &&
        validStudioString(content.unsplashPhotoUrl, 800) &&
        content.heroMode.matches("^(text|logo)$") &&
        content.heroLogoSource.matches("^(|upload|library)$") &&
        validStudioString(content.heroLogoLibraryId, 80) &&
        validStudioString(content.heroLogoStoragePath, 240) &&
        validStudioString(content.heroLogoName, 80) &&
        content.heroLogoScale >= 0.5 &&
        content.heroLogoScale <= 2 &&
        content.heroLogoClearSpace >= 0 &&
        content.heroLogoClearSpace <= 12 &&
        content.fontKey.matches(
          "^(montserrat|league-spartan|google-sans|bebas-neue|" +
          "league-gothic|science-gothic|unbounded|bodoni-moda|forum|" +
          "niconne|eb-garamond)$"
        ) &&
        content.fontWeight.matches(
          "^(template|thin|light|medium|bold|black)$"
        ) &&
        content.brandMark.matches("^(central|heart|full)$") &&
        content.brandColor.matches("^(auto|white|charcoal|red)$") &&
        (
          (
            content.backgroundImageSource == "" &&
            content.backgroundImageUrl == "" &&
            content.backgroundImageStoragePath == "" &&
            content.unsplashPhotoId == "" &&
            content.unsplashPhotographerName == "" &&
            content.unsplashPhotographerUrl == "" &&
            content.unsplashPhotoUrl == ""
          ) ||
          (
            content.backgroundImageSource == "upload" &&
            content.backgroundImageUrl == "" &&
            content.backgroundImageStoragePath.matches(
              "^studio-projects/" + projectId + "/[^/]+$"
            ) &&
            content.unsplashPhotoId == "" &&
            content.unsplashPhotographerName == "" &&
            content.unsplashPhotographerUrl == "" &&
            content.unsplashPhotoUrl == ""
          ) ||
          (
            content.backgroundImageSource == "unsplash" &&
            content.backgroundImageUrl.matches("^https://.*") &&
            content.backgroundImageStoragePath == "" &&
            content.unsplashPhotoId.size() > 0 &&
            content.unsplashPhotographerName.size() > 0 &&
            content.unsplashPhotographerUrl.matches("^https://.*") &&
            content.unsplashPhotoUrl.matches("^https://.*")
          )
        ) &&
        content.textAlignment.matches("^(left|center|right)$") &&
        content.textShadow is bool;
    }

    function validSocialContent(content, projectId, templateId) {
      return content is map &&
        content.keys().hasOnly([
          "eyebrow", "optionalTextVisibility", "title", "subtitle",
          "date", "time", "location", "cta",
          "format", "composition", "palette", "flatColor", "overlayColor",
          "overlayBlendMode", "focalX", "focalY",
          "imageZoom", "backgroundImageOpacity", "backgroundImageRotation",
          "backgroundImageSource", "backgroundImageUrl",
          "backgroundImageStoragePath", "unsplashPhotoId",
          "unsplashPhotographerName", "unsplashPhotographerUrl",
          "unsplashPhotoUrl", "heroMode", "heroLogoSource",
          "heroLogoLibraryId", "heroLogoStoragePath", "heroLogoName",
          "heroLogoScale", "heroLogoClearSpace", "fontKey", "fontWeight",
          "brandMark", "brandColor", "textAlignment", "textShadow"
        ]) &&
        content.eyebrow.matches("^.{0,30}$") &&
        content.optionalTextVisibility.matches(
          "^(both|eyebrow|subtitle|none)$"
        ) &&
        validStudioString(content.title, 220) &&
        validStudioString(content.subtitle, 110) &&
        content.date == "" && content.time == "" && content.location == "" &&
        content.cta.matches("^.{0,44}$") &&
        content.format.matches("^(square|portrait)$") &&
        validEventComposition(templateId, content.composition) &&
        content.palette.matches(
          "^(charcoal-red|warm-light|blue-charcoal|paper-red|sky-mint|" +
          "blush-burgundy)$"
        ) &&
        content.flatColor.matches(
          "^(red|cyan|charcoal|white|sky|purple|mint|burgundy|blush|cream)$"
        ) &&
        content.overlayColor.matches(
          "^(red|cyan|charcoal|white|sky|purple|mint|burgundy|blush|cream)$"
        ) &&
        content.overlayBlendMode.matches(
          "^(multiply|screen|overlay|soft-light)$"
        ) &&
        content.focalX >= 0 && content.focalX <= 100 &&
        content.focalY >= 0 && content.focalY <= 100 &&
        content.imageZoom >= 1 && content.imageZoom <= 2 &&
        content.backgroundImageOpacity >= 0 &&
        content.backgroundImageOpacity <= 1 &&
        content.backgroundImageRotation >= 0 &&
        content.backgroundImageRotation <= 360 &&
        content.backgroundImageSource.matches("^(|upload|unsplash)$") &&
        validStudioString(content.backgroundImageUrl, 1600) &&
        validStudioString(content.backgroundImageStoragePath, 240) &&
        validStudioString(content.unsplashPhotoId, 80) &&
        validStudioString(content.unsplashPhotographerName, 120) &&
        validStudioString(content.unsplashPhotographerUrl, 800) &&
        validStudioString(content.unsplashPhotoUrl, 800) &&
        (
          (
            content.backgroundImageSource == "" &&
            content.backgroundImageUrl == "" &&
            content.backgroundImageStoragePath == "" &&
            content.unsplashPhotoId == "" &&
            content.unsplashPhotographerName == "" &&
            content.unsplashPhotographerUrl == "" &&
            content.unsplashPhotoUrl == ""
          ) ||
          (
            content.backgroundImageSource == "upload" &&
            content.backgroundImageUrl == "" &&
            content.backgroundImageStoragePath.matches(
              "^studio-projects/" + projectId + "/[^/]+$"
            ) &&
            content.unsplashPhotoId == "" &&
            content.unsplashPhotographerName == "" &&
            content.unsplashPhotographerUrl == "" &&
            content.unsplashPhotoUrl == ""
          ) ||
          (
            content.backgroundImageSource == "unsplash" &&
            content.backgroundImageUrl.matches("^https://.*") &&
            content.backgroundImageStoragePath == "" &&
            content.unsplashPhotoId.size() > 0 &&
            content.unsplashPhotographerName.size() > 0 &&
            content.unsplashPhotographerUrl.matches("^https://.*") &&
            content.unsplashPhotoUrl.matches("^https://.*")
          )
        ) &&
        content.heroMode.matches("^(text|logo)$") &&
        content.heroLogoSource.matches("^(|upload|library)$") &&
        validStudioString(content.heroLogoLibraryId, 80) &&
        validStudioString(content.heroLogoStoragePath, 240) &&
        validStudioString(content.heroLogoName, 80) &&
        (
          templateId == "social-simple-statement" ?
            validHeroReference(content, projectId) :
            content.heroMode == "text" &&
            content.heroLogoSource == "" &&
            content.heroLogoLibraryId == "" &&
            content.heroLogoStoragePath == "" &&
            content.heroLogoName == ""
        ) &&
        content.heroLogoScale >= 0.5 && content.heroLogoScale <= 2 &&
        content.heroLogoClearSpace >= 0 && content.heroLogoClearSpace <= 12 &&
        content.fontKey.matches(
          "^(montserrat|league-spartan|google-sans|bodoni-moda|forum|" +
          "eb-garamond)$"
        ) &&
        content.fontWeight.matches(
          "^(template|thin|light|medium|bold|black)$"
        ) &&
        content.brandMark.matches("^(central|heart|full)$") &&
        content.brandColor.matches("^(auto|white|charcoal|red)$") &&
        content.textAlignment.matches("^(left|center|right)$") &&
        content.textShadow is bool;
    }

    function validSocialSlideOrder(slideOrder) {
      return slideOrder is list &&
        slideOrder.size() >= 1 &&
        slideOrder.size() <= 6 &&
        slideOrder[0] == "primary" &&
        slideOrder.toSet().size() == slideOrder.size() &&
        (slideOrder.size() < 2 || validPageId(slideOrder[1])) &&
        (slideOrder.size() < 3 || validPageId(slideOrder[2])) &&
        (slideOrder.size() < 4 || validPageId(slideOrder[3])) &&
        (slideOrder.size() < 5 || validPageId(slideOrder[4])) &&
        (slideOrder.size() < 6 || validPageId(slideOrder[5]));
    }

    function validSocialSlide(data, projectId, templateId) {
      return data is map &&
        data.keys().hasAll([
          "schemaVersion", "content", "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "content", "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        validEventContent(data.content, projectId, templateId);
    }

    function validLegacyStudioProject(data, projectId) {
      return data.keys().hasAll([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "content", "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "sourceId", "sourceEventId", "sourceUrl",
          "sourceUpdatedAt", "content", "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 1 &&
        validStudioString(data.ownerUid, 128) &&
        data.templateId.matches(
          "^(policy-document|event-promotion|event-signal-stack|" +
          "event-rally-poster|event-future-block|event-center-stage|" +
          "event-timeless-center|event-editorial-invitation|" +
          "event-scripted-welcome|social-scripture|social-quote|" +
          "social-statement|" +
          "document-small-group-leader)$"
        ) &&
        data.name.matches("^.{1,80}$") &&
        data.status == "draft" &&
        (
          data.sourceType == "manual" || (
            isEventTemplateId(data.templateId) &&
            data.sourceType == "planning-center" &&
            data.sourceId.matches("^[0-9]{1,80}$") &&
            data.sourceEventId.matches("^[0-9]{1,80}$") &&
            data.sourceUrl.matches("^(|https://.{0,492})$") &&
            data.sourceUpdatedAt is timestamp
          )
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (
          data.templateId == "policy-document" ?
            validPolicyContent(data.content) :
            validEventContent(data.content, projectId, data.templateId)
        );
    }

    function validSocialProject(data, projectId) {
      return data.keys().hasAll([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "postMode", "slideOrder",
          "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "postMode", "slideOrder",
          "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 3 &&
        validStudioString(data.ownerUid, 128) &&
        isSocialTemplateId(data.templateId) &&
        validStudioString(data.name, 80) && data.name.size() > 0 &&
        data.status == "draft" &&
        data.sourceType == "manual" &&
        data.postMode.matches("^(single|carousel)$") &&
        validSocialSlideOrder(data.slideOrder) &&
        (data.postMode == "carousel" || data.slideOrder.size() == 1) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validDocumentProject(data) {
      return data.keys().hasAll([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "pageOrder", "documentSettings", "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "pageOrder", "documentSettings", "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 2 &&
        validStudioString(data.ownerUid, 128) &&
        data.templateId == "document-project" &&
        validStudioString(data.name, 80) && data.name.size() > 0 &&
        data.status == "draft" &&
        data.sourceType == "manual" &&
        validPageOrder(data.pageOrder) &&
        validDocumentSettings(data.documentSettings) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validStudioProject(data, projectId) {
      return data is map &&
        validStudioProjectId(projectId) && (
        (data.schemaVersion == 1 && validLegacyStudioProject(data, projectId)) ||
        (data.schemaVersion == 2 && validDocumentProject(data)) ||
        (data.schemaVersion == 3 && validSocialProject(data, projectId))
      );
    }

    function plannerPermission() {
      return currentUser().data.pageAccess.keys().hasAny(["planner"]) ?
        currentUser().data.pageAccess.planner :
        currentUser().data.pageAccess.keys().hasAny(["studio"]) ?
          currentUser().data.pageAccess.studio :
          currentUser().data.pageAccess.keys().hasAny(["settings"]) ?
            currentUser().data.pageAccess.settings :
            "none";
    }

    function canReadPlanner() {
      return isActiveAdminUser() && hasAnySectionAccess(plannerPermission());
    }

    function canEditPlanner() {
      return isActiveAdminUser() && (
        plannerPermission() == "propose" ||
        isEditorLevel(plannerPermission())
      );
    }

    function validPlannerString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validPlannerId(value) {
      return value is string && value.size() > 0 && value.size() <= 128 &&
        value.matches("^[A-Za-z0-9_-]+$");
    }

    function isStarterPlannerPlaybook(playbookId) {
      return playbookId in [
        "level-1-major",
        "level-2-event",
        "level-2-ongoing-awareness",
        "level-2-ongoing-interest",
        "level-3-featured",
        "level-3-standard",
        "level-4-featured",
        "level-4-standard",
        "level-5-interest"
      ];
    }

    function validPlannerWeekday(value) {
      return value is int && value >= 0 && value <= 6;
    }

    function validPlannerWeekdays(values) {
      return values is list && values.size() <= 7 &&
        (values.size() < 1 || validPlannerWeekday(values[0])) &&
        (values.size() < 2 || validPlannerWeekday(values[1])) &&
        (values.size() < 3 || validPlannerWeekday(values[2])) &&
        (values.size() < 4 || validPlannerWeekday(values[3])) &&
        (values.size() < 5 || validPlannerWeekday(values[4])) &&
        (values.size() < 6 || validPlannerWeekday(values[5])) &&
        (values.size() < 7 || validPlannerWeekday(values[6]));
    }

    function validPlannerLevel(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function validPlannerLevels(values) {
      return values is list && values.size() <= 5 &&
        (values.size() < 1 || validPlannerLevel(values[0])) &&
        (values.size() < 2 || validPlannerLevel(values[1])) &&
        (values.size() < 3 || validPlannerLevel(values[2])) &&
        (values.size() < 4 || validPlannerLevel(values[3])) &&
        (values.size() < 5 || validPlannerLevel(values[4]));
    }

    function validPlannerShortStrings(values) {
      return values is list && values.size() <= 5 &&
        (values.size() < 1 || validPlannerString(values[0], 80)) &&
        (values.size() < 2 || validPlannerString(values[1], 80)) &&
        (values.size() < 3 || validPlannerString(values[2], 80)) &&
        (values.size() < 4 || validPlannerString(values[3], 80)) &&
        (values.size() < 5 || validPlannerString(values[4], 80));
    }

    function validPlannerWeek(week) {
      return week is map &&
        week.keys().hasAll(["weekNumber", "phase", "label", "plays"]) &&
        week.keys().hasOnly(["weekNumber", "phase", "label", "plays"]) &&
        week.weekNumber is int && week.weekNumber >= 1 &&
        week.weekNumber <= 12 &&
        validPlannerString(week.phase, 50) && week.phase.size() > 0 &&
        validPlannerString(week.label, 120) &&
        week.plays is list && week.plays.size() <= 40;
    }

    function validPlannerWeeks(weeks) {
      // Large six-to-eight-week playbooks can exceed Firestore's 1,000-rule
      // expression limit when every nested week is expanded in one rule.
      // Keep the immutable snapshot bounded and validate both boundary week
      // envelopes here; Planner validates every week and play before writing.
      return weeks is list && weeks.size() > 0 && weeks.size() <= 12 &&
        validPlannerWeek(weeks[0]) &&
        validPlannerWeek(weeks[weeks.size() - 1]) &&
        weeks[0].weekNumber == 1 &&
        weeks[weeks.size() - 1].weekNumber == weeks.size();
    }

    function validPlannerPlaybook(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "level", "name", "campaignType",
        "durationWeeks", "currentVersion", "active", "description",
        "updatedByUid", "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "level", "name", "campaignType",
        "durationWeeks", "currentVersion", "active", "description",
        "updatedByUid", "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 && validPlannerLevel(data.level) &&
        validPlannerString(data.name, 120) && data.name.size() > 0 &&
        validPlannerString(data.campaignType, 80) &&
        data.durationWeeks is int && data.durationWeeks >= 1 &&
        data.durationWeeks <= 12 && data.currentVersion is int &&
        data.currentVersion >= 1 && data.active is bool &&
        validPlannerString(data.description, 1000) &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerPlaybookVersion(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "playbookId", "level", "name", "campaignType",
        "durationWeeks", "version", "active", "description", "weeks",
        "createdByUid", "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "playbookId", "level", "name", "campaignType",
        "durationWeeks", "version", "active", "description", "weeks",
        "createdByUid", "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 && validPlannerId(data.playbookId) &&
        validPlannerLevel(data.level) && validPlannerString(data.name, 120) &&
        data.name.size() > 0 && validPlannerString(data.campaignType, 80) &&
        data.durationWeeks is int && data.durationWeeks >= 1 &&
        data.durationWeeks <= 12 && data.durationWeeks == data.weeks.size() &&
        data.version is int && data.version >= 1 &&
        data.active is bool && validPlannerString(data.description, 1000) &&
        validPlannerWeeks(data.weeks) && data.createdByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerCampaign(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "name", "eventDate", "registrationDeadline",
        "submittedAt", "recommendedStartDate", "isOnTime", "daysLate",
        "weeksLate", "level", "campaignType", "playbookId",
        "playbookVersion", "durationWeeks", "sourceEventId", "notes",
        "status", "createdByUid", "updatedByUid", "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "name", "eventDate", "registrationDeadline",
        "submittedAt", "recommendedStartDate", "isOnTime", "daysLate",
        "weeksLate", "level", "campaignType", "playbookId",
        "playbookVersion", "durationWeeks", "sourceEventId", "notes",
        "status", "createdByUid", "updatedByUid", "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 && validPlannerString(data.name, 140) &&
        data.name.size() > 0 && data.eventDate is timestamp &&
        (data.registrationDeadline == null || data.registrationDeadline is timestamp) &&
        data.submittedAt is timestamp && data.recommendedStartDate is timestamp &&
        data.isOnTime is bool && data.daysLate is int && data.daysLate >= 0 &&
        data.weeksLate is int && data.weeksLate >= 0 &&
        validPlannerLevel(data.level) && validPlannerString(data.campaignType, 80) &&
        validPlannerId(data.playbookId) && data.playbookVersion is int &&
        data.playbookVersion >= 1 && data.durationWeeks is int &&
        data.durationWeeks >= 1 && data.durationWeeks <= 12 &&
        validPlannerString(data.sourceEventId, 100) &&
        validPlannerString(data.notes, 3000) &&
        data.status in ["draft", "active", "completed", "archived"] &&
        validPlannerString(data.createdByUid, 128) &&
        data.createdByUid.size() > 0 && data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerSmuggle(data) {
      return data is map && data.keys().hasAll([
        "hostCampaignId", "hostScheduledPlayId", "beneficiaryCampaignId",
        "beneficiaryName", "strategy"
      ]) && data.keys().hasOnly([
        "hostCampaignId", "hostScheduledPlayId", "beneficiaryCampaignId",
        "beneficiaryName", "strategy"
      ]) && validPlannerId(data.hostCampaignId) &&
        validPlannerId(data.hostScheduledPlayId) &&
        validPlannerId(data.beneficiaryCampaignId) &&
        validPlannerString(data.beneficiaryName, 140) &&
        data.strategy == "SMUGGLE";
    }

    function validPlannerScheduledPlay(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "campaignId", "campaignName", "campaignLevel",
        "campaignType", "playbookId", "playbookVersion", "templatePlayId",
        "weekNumber", "phase", "playType", "channel", "resourceId",
        "originalScheduledDate", "scheduledDate", "eligibleWeekdays", "status",
        "requirement", "lateBehavior", "source", "manuallyAdjusted", "locked",
        "conflictState", "conflictReason", "lateReason", "supportsSmuggle",
        "smuggle", "createdByUid", "updatedByUid", "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "campaignId", "campaignName", "campaignLevel",
        "campaignType", "playbookId", "playbookVersion", "templatePlayId",
        "weekNumber", "phase", "playType", "channel", "resourceId",
        "originalScheduledDate", "scheduledDate", "eligibleWeekdays", "status",
        "requirement", "lateBehavior", "source", "manuallyAdjusted", "locked",
        "conflictState", "conflictReason", "lateReason", "supportsSmuggle",
        "smuggle", "createdByUid", "updatedByUid", "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 && validPlannerId(data.campaignId) &&
        validPlannerString(data.campaignName, 140) && data.campaignName.size() > 0 &&
        validPlannerLevel(data.campaignLevel) &&
        validPlannerString(data.campaignType, 80) && validPlannerId(data.playbookId) &&
        data.playbookVersion is int && data.playbookVersion >= 1 &&
        validPlannerString(data.templatePlayId, 100) &&
        data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 12 &&
        validPlannerString(data.phase, 50) && validPlannerString(data.playType, 120) &&
        data.playType.size() > 0 && validPlannerString(data.channel, 100) &&
        validPlannerString(data.resourceId, 100) &&
        data.originalScheduledDate is timestamp && data.scheduledDate is timestamp &&
        validPlannerWeekdays(data.eligibleWeekdays) &&
        data.status in [
          "scheduled", "completed", "missed", "skipped", "rescheduled",
          "conflict", "needs-decision"
        ] && data.requirement in ["required", "optional", "as-available"] &&
        data.lateBehavior in [
          "SKIP", "NEXT_AVAILABLE_SLOT", "NEXT_OCCURRENCE", "MANUAL_REVIEW"
        ] && validPlannerString(data.source, 60) && data.manuallyAdjusted is bool &&
        data.locked is bool && validPlannerString(data.conflictState, 80) &&
        validPlannerString(data.conflictReason, 800) &&
        validPlannerString(data.lateReason, 800) && data.supportsSmuggle is bool &&
        (data.smuggle == null || validPlannerSmuggle(data.smuggle)) &&
        validPlannerString(data.createdByUid, 128) &&
        data.createdByUid.size() > 0 && data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerCapacityRule(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "name", "channel", "capacity", "typicalCapacity",
        "capacityPeriod", "allowedWeekdays", "perCampaignMaximum", "eligibleLevels",
        "autoResolve", "supportsSmuggle", "allocationStrategy",
        "showOnDashboard", "active", "updatedByUid", "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "name", "channel", "capacity", "typicalCapacity",
        "capacityPeriod", "allowedWeekdays", "perCampaignMaximum", "eligibleLevels",
        "autoResolve", "supportsSmuggle", "allocationStrategy",
        "showOnDashboard", "active", "updatedByUid", "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 && validPlannerString(data.name, 120) &&
        data.name.size() > 0 && validPlannerString(data.channel, 100) &&
        data.capacity is int && data.capacity >= 1 && data.capacity <= 50 &&
        data.typicalCapacity is int && data.typicalCapacity >= 1 &&
        data.typicalCapacity <= data.capacity &&
        data.capacityPeriod in ["day", "week", "sunday"] &&
        validPlannerWeekdays(data.allowedWeekdays) &&
        data.perCampaignMaximum is int && data.perCampaignMaximum >= 1 &&
        data.perCampaignMaximum <= 20 && validPlannerLevels(data.eligibleLevels) &&
        data.autoResolve is bool && data.supportsSmuggle is bool &&
        validPlannerString(data.allocationStrategy, 80) &&
        data.showOnDashboard is bool && data.active is bool &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerStandingLane(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "name", "level", "cadence", "fallbackPlaybookId",
        "priorityOrder", "eligibleSmuggleLevels", "active", "updatedByUid",
        "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "name", "level", "cadence", "fallbackPlaybookId",
        "priorityOrder", "eligibleSmuggleLevels", "active", "updatedByUid",
        "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 && validPlannerString(data.name, 120) &&
        data.name.size() > 0 && validPlannerLevel(data.level) &&
        data.cadence == "weekly" && validPlannerId(data.fallbackPlaybookId) &&
        validPlannerShortStrings(data.priorityOrder) &&
        validPlannerLevels(data.eligibleSmuggleLevels) && data.active is bool &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerRequestStrings(values) {
      return values is list && values.size() <= 12 &&
        (values.size() < 1 || validPlannerString(values[0], 120)) &&
        (values.size() < 2 || validPlannerString(values[1], 120)) &&
        (values.size() < 3 || validPlannerString(values[2], 120)) &&
        (values.size() < 4 || validPlannerString(values[3], 120)) &&
        (values.size() < 5 || validPlannerString(values[4], 120)) &&
        (values.size() < 6 || validPlannerString(values[5], 120)) &&
        (values.size() < 7 || validPlannerString(values[6], 120)) &&
        (values.size() < 8 || validPlannerString(values[7], 120)) &&
        (values.size() < 9 || validPlannerString(values[8], 120)) &&
        (values.size() < 10 || validPlannerString(values[9], 120)) &&
        (values.size() < 11 || validPlannerString(values[10], 120)) &&
        (values.size() < 12 || validPlannerString(values[11], 120));
    }

    function validPlannerRequestDates(values) {
      return values is list && values.size() <= 8 &&
        (values.size() < 1 || values[0] is timestamp) &&
        (values.size() < 2 || values[1] is timestamp) &&
        (values.size() < 3 || values[2] is timestamp) &&
        (values.size() < 4 || values[3] is timestamp) &&
        (values.size() < 5 || values[4] is timestamp) &&
        (values.size() < 6 || values[5] is timestamp) &&
        (values.size() < 7 || values[6] is timestamp) &&
        (values.size() < 8 || values[7] is timestamp);
    }

    function validPlannerRequestEligibility(value) {
      return value is map && value.keys().hasAll(["qualified"]) &&
        value.keys().hasOnly(["qualified"]) && value.qualified == true;
    }

    function validPlannerRequestDateOrder(values) {
      return (values.size() < 2 || values[1] > values[0]) &&
        (values.size() < 3 || values[2] > values[1]) &&
        (values.size() < 4 || values[3] > values[2]) &&
        (values.size() < 5 || values[4] > values[3]) &&
        (values.size() < 6 || values[5] > values[4]) &&
        (values.size() < 7 || values[6] > values[5]) &&
        (values.size() < 8 || values[7] > values[6]);
    }

    function validPlannerRequestDateState(data) {
      return (
        data.dateParseStatus in ["needs-review", "manual-required"] &&
        data.dateParseKind == null && data.eventDate == null &&
        data.eventDates.size() == 0 && data.eventDateEnd == null &&
        data.dateSource == "manual-review"
      ) || (
        data.dateParseStatus in ["parsed", "manual"] &&
        data.dateParseKind in ["single", "range", "multiple"] &&
        data.eventDate is timestamp && data.eventDates.size() >= 1 &&
        data.eventDates[0] == data.eventDate &&
        (
          (data.dateParseKind == "single" && data.eventDates.size() == 1 &&
            data.eventDateEnd == null) ||
          (data.dateParseKind == "range" && data.eventDates.size() == 2 &&
            data.eventDateEnd == data.eventDates[1] &&
            data.eventDateEnd >= data.eventDate) ||
          (data.dateParseKind == "multiple" &&
            data.eventDates.size() >= 2 && data.eventDateEnd == null &&
            validPlannerRequestDateOrder(data.eventDates))
        ) &&
        (
          (data.dateParseStatus == "parsed" &&
            data.dateSource == "form-parser") ||
          (data.dateParseStatus == "manual" &&
            data.dateSource == "manual-review")
        )
      );
    }

    function validPlannerRequestCampaignLink(data) {
      return data.status != "converted" || (
        existsAfter(
          /databases/$(database)/documents/centralPromotionCampaigns/$(data.campaignId)
        ) &&
        getAfter(
          /databases/$(database)/documents/centralPromotionCampaigns/$(data.campaignId)
        ).data.sourceEventId ==
          "pco-form:" + data.sourceFormId + ":" + data.sourceSubmissionId
      );
    }

    function validPlannerRequest(data) {
      return data is map && data.keys().hasAll([
        "schemaVersion", "source", "sourceFormId", "sourceFormName",
        "sourceSubmissionId", "submittedAt", "receivedAt", "status",
        "proposedName", "ministry", "description", "notes",
        "requestedPlatforms", "requestedPromotionStart",
        "requestedPromotionEnd", "rawEventDateText", "eventDate",
        "eventDates", "eventDateEnd", "dateParseStatus", "dateParseKind",
        "dateSource", "eligibility", "campaignId", "reviewedByUid",
        "createdAt", "updatedAt"
      ]) && data.keys().hasOnly([
        "schemaVersion", "source", "sourceFormId", "sourceFormName",
        "sourceSubmissionId", "submittedAt", "receivedAt", "status",
        "proposedName", "ministry", "description", "notes",
        "requestedPlatforms", "requestedPromotionStart",
        "requestedPromotionEnd", "rawEventDateText", "eventDate",
        "eventDates", "eventDateEnd", "dateParseStatus", "dateParseKind",
        "dateSource", "eligibility", "campaignId", "reviewedByUid",
        "createdAt", "updatedAt"
      ]) && data.schemaVersion == 1 &&
        data.source == "planning-center-form" &&
        validPlannerString(data.sourceFormId, 32) &&
        data.sourceFormId.matches("^[0-9]+$") &&
        validPlannerString(data.sourceFormName, 120) &&
        data.sourceFormName.size() > 0 &&
        validPlannerString(data.sourceSubmissionId, 64) &&
        data.sourceSubmissionId.matches("^[0-9]+$") &&
        data.submittedAt is timestamp && data.receivedAt is timestamp &&
        data.status in ["pending-review", "converted", "dismissed"] &&
        validPlannerString(data.proposedName, 140) &&
        data.proposedName.size() > 0 &&
        validPlannerString(data.ministry, 140) &&
        validPlannerString(data.description, 3000) &&
        validPlannerString(data.notes, 3000) &&
        validPlannerRequestStrings(data.requestedPlatforms) &&
        (data.requestedPromotionStart == null ||
          data.requestedPromotionStart is timestamp) &&
        (data.requestedPromotionEnd == null ||
          data.requestedPromotionEnd is timestamp) &&
        validPlannerString(data.rawEventDateText, 500) &&
        (data.eventDate == null || data.eventDate is timestamp) &&
        validPlannerRequestDates(data.eventDates) &&
        (data.eventDateEnd == null || data.eventDateEnd is timestamp) &&
        data.dateParseStatus in [
          "parsed", "needs-review", "manual-required", "manual"
        ] &&
        (data.dateParseKind == null || data.dateParseKind in [
          "single", "range", "multiple"
        ]) &&
        data.dateSource in ["form-parser", "manual-review"] &&
        validPlannerRequestEligibility(data.eligibility) &&
        validPlannerString(data.campaignId, 128) &&
        (
          (data.status == "converted" && validPlannerId(data.campaignId)) ||
          (data.status != "converted" && data.campaignId.size() == 0)
        ) &&
        validPlannerRequestDateState(data) &&
        validPlannerRequestCampaignLink(data) &&
        validPlannerString(data.reviewedByUid, 128) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPlannerRequestStatusTransition() {
      return resource.data.status == "pending-review" &&
        request.resource.data.status in [
          "pending-review", "converted", "dismissed"
        ];
    }

    function validPlannerRequestReview(data) {
      return validPlannerString(data.proposedName, 140) &&
        data.proposedName.size() > 0 &&
        (data.eventDate == null || data.eventDate is timestamp) &&
        validPlannerRequestDates(data.eventDates) &&
        (data.eventDateEnd == null || data.eventDateEnd is timestamp) &&
        data.dateParseStatus in [
          "parsed", "needs-review", "manual-required", "manual"
        ] &&
        (data.dateParseKind == null || data.dateParseKind in [
          "single", "range", "multiple"
        ]) &&
        data.dateSource in ["form-parser", "manual-review"] &&
        data.status in ["pending-review", "converted", "dismissed"] &&
        validPlannerString(data.campaignId, 128) &&
        (
          (data.status == "converted" && validPlannerId(data.campaignId)) ||
          (data.status != "converted" && data.campaignId.size() == 0)
        ) &&
        validPlannerRequestDateState(data) &&
        validPlannerRequestCampaignLink(data) &&
        data.reviewedByUid == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function contentSectionPermission(section) {
      return section == "quickLinks" ?
        currentUser().data.pageAccess.quickLinks :
        section == "campaigns" ?
          currentUser().data.pageAccess.campaigns != null ?
            currentUser().data.pageAccess.campaigns :
            currentUser().data.pageAccess.settings :
        section == "nextSteps" ?
          currentUser().data.pageAccess.nextSteps != null ?
            currentUser().data.pageAccess.nextSteps :
            currentUser().data.pageAccess.settings :
        section == "resources" ?
          currentUser().data.pageAccess.resources != null ?
            currentUser().data.pageAccess.resources :
            currentUser().data.pageAccess.settings :
        section == "serveNeeds" ?
          currentUser().data.pageAccess.serveNeeds != null ?
            currentUser().data.pageAccess.serveNeeds :
            currentUser().data.pageAccess.settings :
        section == "roomRules" ?
          currentUser().data.pageAccess.roomRules != null ?
            currentUser().data.pageAccess.roomRules :
            currentUser().data.pageAccess.settings :
        section == "statusBanner" ?
          currentUser().data.pageAccess.statusBanner :
          section == "events" ?
            currentUser().data.pageAccess.events :
            "none";
    }

    function canEditContentSection(section) {
      return isActiveAdminUser() &&
        isEditorLevel(contentSectionPermission(section));
    }

    function canReadContentSection(section) {
      return isActiveAdminUser() &&
        hasAnySectionAccess(contentSectionPermission(section));
    }

    function publicAppDocPermission(documentId) {
      return documentId == "settings" ?
        currentUser().data.pageAccess.hub != null ?
          currentUser().data.pageAccess.hub :
          currentUser().data.pageAccess.settings :
        documentId == "sundaySettings" ?
          currentUser().data.pageAccess.hub != null ?
            currentUser().data.pageAccess.hub :
            currentUser().data.pageAccess.sundaySettings != null ?
              currentUser().data.pageAccess.sundaySettings :
              currentUser().data.pageAccess.settings :
        documentId == "thisSunday" ?
          currentUser().data.pageAccess.thisSunday != null ?
            currentUser().data.pageAccess.thisSunday :
            currentUser().data.pageAccess.settings :
          "none";
    }

    function canEditPublicAppDoc(documentId) {
      return isActiveAdminUser() &&
        isEditorLevel(publicAppDocPermission(documentId));
    }

    function canReadPublicAppDoc(documentId) {
      return isActiveAdminUser() &&
        hasAnySectionAccess(publicAppDocPermission(documentId));
    }

    // Public content is readable by clients, but never writable from the browser.
    match /centralApp/root/public/{documentId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }

    match /centralContent/{section}/items/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /centralContent/{section}/meta/{documentId} {
      allow read: if canReadContentSection(section);
      allow create, update, delete: if false;
    }

    match /centralAppDraft/root/public/{documentId} {
      allow read: if canReadPublicAppDoc(documentId);
      allow create, update: if canEditPublicAppDoc(documentId);
      allow delete: if false;
    }

    match /centralContentDraft/{section}/items/{itemId} {
      allow read: if canReadContentSection(section);
      allow create, update, delete: if canEditContentSection(section);
    }

    match /centralContentDraft/{section}/meta/{documentId} {
      allow read: if canReadContentSection(section);
      allow create, update, delete: if canEditContentSection(section);
    }

    // Admin users can read only their own user record directly from the client.
    // Creating or editing admin records should happen in the console or through
    // privileged server code until the approval workflow exists.
    match /centralAdmin/root/users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /centralAdmin/root/pages/{pageId} {
      allow read: if isActiveAdminUser();
      allow write: if false;
    }

    match /centralAdmin/root/roles/{roleId} {
      allow read: if hasAdminSectionAccess();
      allow write: if false;
    }

    match /centralAdmin/root/changeRequests/{requestId} {
      allow read: if isActiveAdminUser();
      allow write: if false;
    }

    match /centralAdmin/root/auditLog/{logId} {
      allow read: if hasAdminSectionAccess();
      allow write: if false;
    }

    match /centralAdmin/root/public/{documentId} {
      allow read: if isActiveAdminUser();
      allow write: if false;
    }

    match /centralStudioProjects/{projectId} {
      allow read: if canReadStudioProject(projectId, resource.data);
      allow create: if canEditStudio() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validStudioProject(request.resource.data, projectId);
      allow update: if canEditStudioProject(projectId, resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (
            resource.data.schemaVersion == request.resource.data.schemaVersion &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "status", "sourceType", "sourceId", "sourceEventId",
              "sourceUrl", "sourceUpdatedAt", "postMode", "slideOrder",
              "content", "pageOrder", "documentSettings", "updatedAt"
            ])
          ) ||
          (
            resource.data.schemaVersion == 1 &&
            resource.data.templateId == "policy-document" &&
            request.resource.data.schemaVersion == 2 &&
            request.resource.data.templateId == "document-project" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "schemaVersion", "templateId", "name", "status", "sourceType",
              "content", "pageOrder", "documentSettings", "updatedAt"
            ])
          ) ||
          (
            resource.data.schemaVersion == 1 &&
            isSocialTemplateId(resource.data.templateId) &&
            request.resource.data.schemaVersion == 3 &&
            request.resource.data.templateId == resource.data.templateId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "schemaVersion", "name", "status", "sourceType", "sourceId",
              "sourceEventId", "sourceUrl", "sourceUpdatedAt", "postMode",
              "slideOrder", "content", "updatedAt"
            ])
          )
        ) &&
        request.resource.data.updatedAt == request.time &&
        validStudioProject(request.resource.data, projectId);
      allow delete: if canEditStudio() &&
        resource.data.ownerUid == request.auth.uid;

      match /slides/{slideId} {
        function parentProjectPath() {
          return /databases/$(database)/documents/centralStudioProjects/$(projectId);
        }

        function parentProject() {
          return get(parentProjectPath()).data;
        }

        function parentProjectAfterWrite() {
          return getAfter(parentProjectPath()).data;
        }

        function primarySlideAfterWrite() {
          return getAfter(
            /databases/$(database)/documents/centralStudioProjects/$(projectId)/slides/primary
          ).data;
        }

        function canReadParentProject() {
          return exists(parentProjectPath()) &&
            canReadStudioProject(projectId, parentProject());
        }

        function canEditParentProject() {
          return exists(parentProjectPath()) &&
            canEditStudioProject(projectId, parentProject());
        }

        function canEditParentProjectAfterWrite() {
          return existsAfter(parentProjectPath()) &&
            canEditStudioProject(projectId, parentProjectAfterWrite());
        }

        allow read: if canReadParentProject();
        allow create: if canEditParentProjectAfterWrite() &&
          parentProjectAfterWrite().schemaVersion == 3 &&
          slideId in parentProjectAfterWrite().slideOrder &&
          request.resource.data.content.format ==
            primarySlideAfterWrite().content.format &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          validSocialSlide(
            request.resource.data,
            projectId,
            parentProjectAfterWrite().templateId
          );
        allow update: if canEditParentProject() &&
          existsAfter(parentProjectPath()) &&
          parentProjectAfterWrite().schemaVersion == 3 &&
          slideId in parentProjectAfterWrite().slideOrder &&
          request.resource.data.content.format ==
            primarySlideAfterWrite().content.format &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "content", "updatedAt"
          ]) &&
          validSocialSlide(
            request.resource.data,
            projectId,
            parentProjectAfterWrite().templateId
          );
        allow delete: if canEditParentProject() &&
          (
            !existsAfter(parentProjectPath()) ||
            !(slideId in parentProjectAfterWrite().slideOrder)
          );
      }

      match /pages/{pageId} {
        function parentProjectPath() {
          return /databases/$(database)/documents/centralStudioProjects/$(projectId);
        }

        function canReadParentProject() {
          return exists(parentProjectPath()) &&
            canReadStudioProject(projectId, get(parentProjectPath()).data);
        }

        function canEditParentProject() {
          return exists(parentProjectPath()) &&
            canEditStudioProject(projectId, get(parentProjectPath()).data);
        }

        function canEditParentProjectAfterWrite() {
          return existsAfter(parentProjectPath()) &&
            canEditStudioProject(
              projectId,
              getAfter(parentProjectPath()).data
            );
        }

        allow read: if canReadParentProject();
        allow create: if canEditParentProjectAfterWrite() &&
          pageId in getAfter(parentProjectPath()).data.pageOrder &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          validDocumentPage(request.resource.data);
        allow update: if canEditParentProject() &&
          pageId in get(parentProjectPath()).data.pageOrder &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "templateId", "content", "updatedAt"
          ]) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time &&
          validDocumentPage(request.resource.data);
        allow delete: if canEditParentProject() &&
          (
            !existsAfter(parentProjectPath()) ||
            !(pageId in getAfter(parentProjectPath()).data.pageOrder)
          );

        match /cards/{cardId} {
          function directoryPagePath() {
            return /databases/$(database)/documents/centralStudioProjects/$(projectId)/pages/$(pageId);
          }

          function isActiveDirectoryPage() {
            return exists(directoryPagePath()) &&
              pageId in get(parentProjectPath()).data.pageOrder &&
              get(directoryPagePath()).data.templateId == "document-directory";
          }

          function directoryCardIsListed() {
            return isActiveDirectoryPage() &&
              cardId in get(directoryPagePath()).data.content.cardOrder;
          }

          allow read: if canReadParentProject();
          allow create: if canEditParentProject() &&
            directoryCardIsListed() &&
            request.resource.data.id == cardId &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.updatedAt == request.time &&
            validDirectoryCard(request.resource.data, projectId);
          allow update: if canEditParentProject() &&
            directoryCardIsListed() &&
            request.resource.data.id == cardId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "subtitle", "details", "imageUrl", "imageStoragePath",
              "sourceType", "sourceId", "publicUrl", "updatedAt"
            ]) &&
            validDirectoryCard(request.resource.data, projectId);
          allow delete: if canEditParentProject() &&
            (
              !exists(directoryPagePath()) ||
              !(pageId in get(parentProjectPath()).data.pageOrder) ||
              get(directoryPagePath()).data.templateId !=
                "document-directory" ||
              !(
                cardId in
                get(directoryPagePath()).data.content.cardOrder
              )
            );
        }
      }
    }

    match /centralStudioMemberships/{membershipId} {
      allow read: if canUseStudio() &&
        resource.data.memberUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /centralStudioLogoLibrary/{logoId} {
      allow read: if canUseStudio();
      allow create: if canManageStudioLogoLibrary() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validStudioLogo(request.resource.data, logoId);
      allow update: if canManageStudioLogoLibrary() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "status", "updatedAt"
        ]) &&
        request.resource.data.storagePath == resource.data.storagePath &&
        request.resource.data.contentType == resource.data.contentType &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validStudioLogo(request.resource.data, logoId);
      allow delete: if false;
    }

    match /centralStudioShares/{shareId} {
      allow read, write: if false;
    }

    match /centralPromotionPlaybooks/{playbookId} {
      allow read: if canReadPlanner();
      allow create: if canEditPlanner() && validPlannerId(playbookId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validPlannerPlaybook(request.resource.data);
      allow update: if canEditPlanner() && validPlannerId(playbookId) &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validPlannerPlaybook(request.resource.data);
      allow delete: if canEditPlanner() &&
        !isStarterPlannerPlaybook(playbookId);
    }

    match /centralPromotionPlaybookVersions/{versionId} {
      allow read: if canReadPlanner();
      allow create: if canEditPlanner() && validPlannerId(versionId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validPlannerPlaybookVersion(request.resource.data);
      allow update, delete: if false;
    }

    match /centralPromotionCampaigns/{campaignId} {
      allow read: if canReadPlanner();
      allow create: if canEditPlanner() && validPlannerId(campaignId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validPlannerCampaign(request.resource.data);
      allow update: if canEditPlanner() && validPlannerId(campaignId) &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.playbookId == resource.data.playbookId &&
        request.resource.data.playbookVersion == resource.data.playbookVersion &&
        request.resource.data.submittedAt == resource.data.submittedAt &&
        request.resource.data.recommendedStartDate == resource.data.recommendedStartDate &&
        request.resource.data.sourceEventId == resource.data.sourceEventId &&
        request.resource.data.updatedAt == request.time &&
        validPlannerCampaign(request.resource.data);
      allow delete: if canEditPlanner();
    }

    match /centralPromotionScheduledPlays/{playId} {
      allow read: if canReadPlanner();
      allow create: if canEditPlanner() && validPlannerId(playId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validPlannerScheduledPlay(request.resource.data);
      allow update: if canEditPlanner() && validPlannerId(playId) &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.campaignId == resource.data.campaignId &&
        request.resource.data.playbookId == resource.data.playbookId &&
        request.resource.data.playbookVersion == resource.data.playbookVersion &&
        request.resource.data.templatePlayId == resource.data.templatePlayId &&
        request.resource.data.originalScheduledDate == resource.data.originalScheduledDate &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validPlannerScheduledPlay(request.resource.data);
      allow delete: if canEditPlanner() &&
        !existsAfter(/databases/$(database)/documents/centralPromotionCampaigns/$(resource.data.campaignId));
    }

    match /centralPromotionCapacityRules/{ruleId} {
      allow read: if canReadPlanner();
      allow create: if canEditPlanner() && validPlannerId(ruleId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validPlannerCapacityRule(request.resource.data);
      allow update: if canEditPlanner() && validPlannerId(ruleId) &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validPlannerCapacityRule(request.resource.data);
      allow delete: if false;
    }

    match /centralPromotionStandingLanes/{laneId} {
      allow read: if canReadPlanner();
      allow create: if canEditPlanner() && validPlannerId(laneId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validPlannerStandingLane(request.resource.data);
      allow update: if canEditPlanner() && validPlannerId(laneId) &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validPlannerStandingLane(request.resource.data);
      allow delete: if false;
    }

    match /centralPromotionRequests/{requestId} {
      allow read: if canReadPlanner();
      // Only the signed Planning Center webhook uses the Admin SDK to create
      // requests. Browsers cannot fabricate or delete source submissions.
      allow create, delete: if false;
      allow update: if canEditPlanner() &&
        requestId.matches("^pco_[0-9]+_[0-9]+$") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "proposedName", "eventDate", "eventDates", "eventDateEnd",
          "dateParseStatus", "dateParseKind", "dateSource", "status",
          "campaignId", "reviewedByUid", "updatedAt"
        ]) &&
        validPlannerRequestStatusTransition() &&
        validPlannerRequestReview(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
