rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/centralAdmin/root/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function currentUser() {
      return get(userDocPath());
    }

    function isActiveAdminUser() {
      return hasUserDoc() && currentUser().data.active == true;
    }

    function hasAdminSectionAccess() {
      return isActiveAdminUser() && (
        isAdminLevel(currentUser().data.pageAccess.users) ||
        isAdminLevel(currentUser().data.pageAccess.roles) ||
        isAdminLevel(currentUser().data.pageAccess.changeRequests) ||
        isAdminLevel(currentUser().data.pageAccess.settings)
      );
    }

    function isAdminLevel(permission) {
      return permission == "approve" || permission == "admin";
    }

    function isEditorLevel(permission) {
      return permission == "edit" ||
        permission == "approve" ||
        permission == "admin";
    }

    function hasAnySectionAccess(permission) {
      return permission == "view" ||
        permission == "propose" ||
        permission == "edit" ||
        permission == "approve" ||
        permission == "admin";
    }

    // Studio projects contain creative content only. Account identity remains
    // in centralAdmin, while ownership and server-issued memberships control
    // access to each project.
    function studioPermission() {
      return currentUser().data.pageAccess.studio != null ?
        currentUser().data.pageAccess.studio :
        currentUser().data.pageAccess.settings;
    }

    function canUseStudio() {
      return isActiveAdminUser() && hasAnySectionAccess(studioPermission());
    }

    function canEditStudio() {
      return isActiveAdminUser() && (
        studioPermission() == "propose" ||
        isEditorLevel(studioPermission())
      );
    }

    function studioMembershipPath(projectId) {
      return /databases/$(database)/documents/centralStudioMemberships/$(request.auth.uid + "_" + projectId);
    }

    function hasStudioMembership(projectId) {
      return canUseStudio() &&
        exists(studioMembershipPath(projectId)) &&
        get(studioMembershipPath(projectId)).data.memberUid == request.auth.uid &&
        get(studioMembershipPath(projectId)).data.projectId == projectId &&
        get(studioMembershipPath(projectId)).data.permission == "edit";
    }

    function canReadStudioProject(projectId, data) {
      return canUseStudio() && (
        data.ownerUid == request.auth.uid ||
        hasStudioMembership(projectId)
      );
    }

    function canEditStudioProject(projectId, data) {
      return canEditStudio() && (
        data.ownerUid == request.auth.uid ||
        hasStudioMembership(projectId)
      );
    }

    function validStudioString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validPolicyContent(content) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "operatingRuleLabel", "operatingRule", "primarySectionLabel",
          "primarySectionTitle", "primaryItemsText", "secondarySectionLabel",
          "secondarySectionTitle", "secondaryItemsText", "ownerLabel",
          "ownerTitle", "ownerItemsText", "processLabel", "processStepsText",
          "footerNote", "footerReference", "accent"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "audience", "documentNumber", "title", "subtitle",
          "operatingRuleLabel", "operatingRule", "primarySectionLabel",
          "primarySectionTitle", "primaryItemsText", "secondarySectionLabel",
          "secondarySectionTitle", "secondaryItemsText", "ownerLabel",
          "ownerTitle", "ownerItemsText", "processLabel", "processStepsText",
          "footerNote", "footerReference", "accent"
        ]) &&
        validStudioString(content.eyebrow, 52) &&
        validStudioString(content.audience, 28) &&
        validStudioString(content.documentNumber, 18) &&
        validStudioString(content.title, 72) &&
        validStudioString(content.subtitle, 150) &&
        validStudioString(content.operatingRuleLabel, 32) &&
        validStudioString(content.operatingRule, 320) &&
        validStudioString(content.primarySectionLabel, 32) &&
        validStudioString(content.primarySectionTitle, 38) &&
        validStudioString(content.primaryItemsText, 700) &&
        validStudioString(content.secondarySectionLabel, 32) &&
        validStudioString(content.secondarySectionTitle, 38) &&
        validStudioString(content.secondaryItemsText, 700) &&
        validStudioString(content.ownerLabel, 32) &&
        validStudioString(content.ownerTitle, 38) &&
        validStudioString(content.ownerItemsText, 480) &&
        validStudioString(content.processLabel, 30) &&
        validStudioString(content.processStepsText, 240) &&
        validStudioString(content.footerNote, 130) &&
        validStudioString(content.footerReference, 34) &&
        content.accent == "red";
    }

    function validEventComposition(templateId, composition) {
      return (
          templateId in ["event-promotion", "event-signal-stack"] &&
          composition in [
            "editorial", "signal", "split", "color-overlay", "flat"
          ]
        ) || (
          templateId == "event-rally-poster" &&
          composition in [
            "rally-stripes", "rally-frame", "editorial",
            "color-overlay", "flat"
          ]
        ) || (
          templateId == "event-future-block" &&
          composition in [
            "future-grid", "future-cut", "editorial",
            "color-overlay", "flat"
          ]
        ) || (
          templateId == "event-editorial-invitation" &&
          composition in [
            "editorial-flow", "editorial-frame", "editorial-column",
            "color-overlay", "flat"
          ]
        ) || (
          templateId == "event-scripted-welcome" &&
          composition in [
            "welcome-halo", "welcome-arch", "welcome-ribbons",
            "color-overlay", "flat"
          ]
        );
    }

    function validEventContent(content, projectId, templateId) {
      return content is map &&
        content.keys().hasAll([
          "eyebrow", "title", "subtitle", "date", "time", "location", "cta",
          "format", "composition", "palette", "flatColor", "overlayColor",
          "overlayBlendMode", "imagePosition", "focalX", "focalY",
          "imageZoom",
          "backgroundImageSource", "backgroundImageUrl",
          "backgroundImageStoragePath", "unsplashPhotoId",
          "unsplashPhotographerName", "unsplashPhotographerUrl",
          "unsplashPhotoUrl", "fontKey", "textAlignment", "textShadow"
        ]) &&
        content.keys().hasOnly([
          "eyebrow", "title", "subtitle", "date", "time", "location", "cta",
          "format", "composition", "palette", "flatColor", "overlayColor",
          "overlayBlendMode", "imagePosition", "focalX", "focalY",
          "imageZoom",
          "backgroundImageSource", "backgroundImageUrl",
          "backgroundImageStoragePath", "unsplashPhotoId",
          "unsplashPhotographerName", "unsplashPhotographerUrl",
          "unsplashPhotoUrl", "fontKey", "textAlignment", "textShadow"
        ]) &&
        validStudioString(content.eyebrow, 30) &&
        validStudioString(content.title, 52) &&
        validStudioString(content.subtitle, 110) &&
        validStudioString(content.date, 28) &&
        validStudioString(content.time, 24) &&
        validStudioString(content.location, 34) &&
        validStudioString(content.cta, 44) &&
        content.format in ["square", "portrait", "screen"] &&
        validEventComposition(templateId, content.composition) &&
        content.palette in ["charcoal-red", "warm-light", "blue-charcoal"] &&
        content.flatColor in [
          "red", "cyan", "charcoal", "white", "sky", "purple", "mint",
          "burgundy", "blush"
        ] &&
        content.overlayColor in [
          "red", "cyan", "charcoal", "white", "sky", "purple", "mint",
          "burgundy", "blush"
        ] &&
        content.overlayBlendMode in [
          "multiply", "screen", "overlay", "soft-light"
        ] &&
        content.imagePosition in ["left center", "center", "right center"] &&
        content.focalX is number &&
        content.focalX >= 0 &&
        content.focalX <= 100 &&
        content.focalY is number &&
        content.focalY >= 0 &&
        content.focalY <= 100 &&
        content.imageZoom is number &&
        content.imageZoom >= 1 &&
        content.imageZoom <= 2 &&
        content.backgroundImageSource in ["", "upload", "unsplash"] &&
        validStudioString(content.backgroundImageUrl, 1600) &&
        validStudioString(content.backgroundImageStoragePath, 240) &&
        validStudioString(content.unsplashPhotoId, 80) &&
        validStudioString(content.unsplashPhotographerName, 120) &&
        validStudioString(content.unsplashPhotographerUrl, 800) &&
        validStudioString(content.unsplashPhotoUrl, 800) &&
        content.fontKey in [
          "montserrat", "league-spartan", "google-sans", "bebas-neue",
          "league-gothic", "science-gothic", "unbounded", "bodoni-moda",
          "forum", "niconne", "eb-garamond"
        ] &&
        (
          (
            content.backgroundImageSource == "" &&
            content.backgroundImageUrl == "" &&
            content.backgroundImageStoragePath == "" &&
            content.unsplashPhotoId == "" &&
            content.unsplashPhotographerName == "" &&
            content.unsplashPhotographerUrl == "" &&
            content.unsplashPhotoUrl == ""
          ) ||
          (
            content.backgroundImageSource == "upload" &&
            content.backgroundImageUrl == "" &&
            content.backgroundImageStoragePath.matches(
              "^studio-projects/" + projectId + "/[^/]+$"
            ) &&
            content.unsplashPhotoId == "" &&
            content.unsplashPhotographerName == "" &&
            content.unsplashPhotographerUrl == "" &&
            content.unsplashPhotoUrl == ""
          ) ||
          (
            content.backgroundImageSource == "unsplash" &&
            content.backgroundImageUrl.matches("^https://.*") &&
            content.backgroundImageStoragePath == "" &&
            content.unsplashPhotoId.size() > 0 &&
            content.unsplashPhotographerName.size() > 0 &&
            content.unsplashPhotographerUrl.matches("^https://.*") &&
            content.unsplashPhotoUrl.matches("^https://.*")
          )
        ) &&
        content.textAlignment in ["left", "center", "right"] &&
        content.textShadow is bool;
    }

    function validStudioProject(data, projectId) {
      return data.keys().hasAll([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "content", "createdAt", "updatedAt"
        ]) &&
        data.keys().hasOnly([
          "schemaVersion", "ownerUid", "templateId", "name", "status",
          "sourceType", "content", "createdAt", "updatedAt"
        ]) &&
        data.schemaVersion == 1 &&
        validStudioString(data.ownerUid, 128) &&
        data.templateId in [
          "policy-document", "event-promotion", "event-signal-stack",
          "event-rally-poster", "event-future-block",
          "event-editorial-invitation", "event-scripted-welcome"
        ] &&
        validStudioString(data.name, 80) && data.name.size() > 0 &&
        data.status == "draft" &&
        data.sourceType == "manual" &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (
          data.templateId == "policy-document" ?
            validPolicyContent(data.content) :
            validEventContent(data.content, projectId, data.templateId)
        );
    }

    function contentSectionPermission(section) {
      return section == "quickLinks" ?
        currentUser().data.pageAccess.quickLinks :
        section == "campaigns" ?
          currentUser().data.pageAccess.campaigns != null ?
            currentUser().data.pageAccess.campaigns :
            currentUser().data.pageAccess.settings :
        section == "nextSteps" ?
          currentUser().data.pageAccess.nextSteps != null ?
            currentUser().data.pageAccess.nextSteps :
            currentUser().data.pageAccess.settings :
        section == "resources" ?
          currentUser().data.pageAccess.resources != null ?
            currentUser().data.pageAccess.resources :
            currentUser().data.pageAccess.settings :
        section == "serveNeeds" ?
          currentUser().data.pageAccess.serveNeeds != null ?
            currentUser().data.pageAccess.serveNeeds :
            currentUser().data.pageAccess.settings :
        section == "roomRules" ?
          currentUser().data.pageAccess.roomRules != null ?
            currentUser().data.pageAccess.roomRules :
            currentUser().data.pageAccess.settings :
        section == "statusBanner" ?
          currentUser().data.pageAccess.statusBanner :
          section == "events" ?
            currentUser().data.pageAccess.events :
            "none";
    }

    function canEditContentSection(section) {
      return isActiveAdminUser() &&
        isEditorLevel(contentSectionPermission(section));
    }

    function canReadContentSection(section) {
      return isActiveAdminUser() &&
        hasAnySectionAccess(contentSectionPermission(section));
    }

    function publicAppDocPermission(documentId) {
      return documentId == "settings" ?
        currentUser().data.pageAccess.hub != null ?
          currentUser().data.pageAccess.hub :
          currentUser().data.pageAccess.settings :
        documentId == "sundaySettings" ?
          currentUser().data.pageAccess.hub != null ?
            currentUser().data.pageAccess.hub :
            currentUser().data.pageAccess.sundaySettings != null ?
              currentUser().data.pageAccess.sundaySettings :
              currentUser().data.pageAccess.settings :
        documentId == "thisSunday" ?
          currentUser().data.pageAccess.thisSunday != null ?
            currentUser().data.pageAccess.thisSunday :
            currentUser().data.pageAccess.settings :
          "none";
    }

    function canEditPublicAppDoc(documentId) {
      return isActiveAdminUser() &&
        isEditorLevel(publicAppDocPermission(documentId));
    }

    function canReadPublicAppDoc(documentId) {
      return isActiveAdminUser() &&
        hasAnySectionAccess(publicAppDocPermission(documentId));
    }

    // Public content is readable by clients, but never writable from the browser.
    match /centralApp/root/public/{documentId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }

    match /centralContent/{section}/items/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /centralContent/{section}/meta/{documentId} {
      allow read: if canReadContentSection(section);
      allow create, update, delete: if false;
    }

    match /centralAppDraft/root/public/{documentId} {
      allow read: if canReadPublicAppDoc(documentId);
      allow create, update: if canEditPublicAppDoc(documentId);
      allow delete: if false;
    }

    match /centralContentDraft/{section}/items/{itemId} {
      allow read: if canReadContentSection(section);
      allow create, update, delete: if canEditContentSection(section);
    }

    match /centralContentDraft/{section}/meta/{documentId} {
      allow read: if canReadContentSection(section);
      allow create, update, delete: if canEditContentSection(section);
    }

    // Admin users can read only their own user record directly from the client.
    // Creating or editing admin records should happen in the console or through
    // privileged server code until the approval workflow exists.
    match /centralAdmin/root/users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /centralAdmin/root/pages/{pageId} {
      allow read: if isActiveAdminUser();
      allow write: if false;
    }

    match /centralAdmin/root/roles/{roleId} {
      allow read: if hasAdminSectionAccess();
      allow write: if false;
    }

    match /centralAdmin/root/changeRequests/{requestId} {
      allow read: if isActiveAdminUser();
      allow write: if false;
    }

    match /centralAdmin/root/auditLog/{logId} {
      allow read: if hasAdminSectionAccess();
      allow write: if false;
    }

    match /centralAdmin/root/public/{documentId} {
      allow read: if isActiveAdminUser();
      allow write: if false;
    }

    match /centralStudioProjects/{projectId} {
      allow read: if canReadStudioProject(projectId, resource.data);
      allow create: if canEditStudio() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validStudioProject(request.resource.data, projectId);
      allow update: if canEditStudioProject(projectId, resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "status", "sourceType", "content", "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time &&
        validStudioProject(request.resource.data, projectId);
      allow delete: if canEditStudio() &&
        resource.data.ownerUid == request.auth.uid;
    }

    match /centralStudioMemberships/{membershipId} {
      allow read: if canUseStudio() &&
        resource.data.memberUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /centralStudioShares/{shareId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
