{
  "name": "crosspointe-central-web",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build:studio": "node scripts/build-studio.mjs",
    "build:youversion": "node scripts/build-youversion-reader.mjs",
    "check:syntax": "node --check public/app.js && node --check public/admin.js && node --check public/event-editor.js && node --check functions/index.js && node --check functions/calendar-source-cache.js && node --check functions/event-overrides.js && node --check functions/room-rules-baseline.js && node --check studio-functions/index.js && node --check studio-functions/studio-core.js && node --check scripts/build-studio.mjs",
    "test:studio-backend": "npm --prefix studio-functions test",
    "test:studio-rules": "firebase emulators:exec --project crosspointe-central-studio-rules --only firestore,storage \"node --test test/studio-security-rules.test.mjs\"",
    "wayfinder:validate": "npm --prefix functions run wayfinder:validate",
    "wayfinder:test": "npm --prefix functions run test:wayfinder",
    "wayfinder:query": "npm --prefix functions run wayfinder:query --",
    "wayfinder:import:dry-run": "npm --prefix functions run wayfinder:import:dry-run",
    "wayfinder:import:emulator": "npm --prefix functions run wayfinder:import:emulator",
    "deploy:live": "firebase deploy --project crosspointe-central --only hosting,functions,firestore,storage",
    "deploy:firestore": "firebase deploy --only firestore",
    "emulators": "firebase emulators:start --project crosspointe-central --only hosting,functions,auth",
    "emulators:full": "firebase emulators:start --project crosspointe-central --only hosting,functions,auth,firestore,storage",
    "emulators:lan": "node scripts/start-lan-emulators.mjs",
    "gmail:token": "node scripts/get-gmail-refresh-token.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@youversion/platform-react-ui": "^2.2.0",
    "esbuild": "^0.28.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.22.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1"
  }
}
