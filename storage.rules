rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function projectPath(projectId) {
      return /databases/(default)/documents/centralStudioProjects/$(projectId);
    }

    function membershipPath(projectId) {
      return /databases/(default)/documents/centralStudioMemberships/$(request.auth.uid + "_" + projectId);
    }

    function studioUserPath() {
      return /databases/(default)/documents/centralAdmin/root/users/$(request.auth.uid);
    }

    function logoMetadataPath(logoId) {
      return /databases/(default)/documents/centralStudioLogoLibrary/$(logoId);
    }

    function studioPermission() {
      return firestore.get(studioUserPath()).data.pageAccess.studio != null ?
        firestore.get(studioUserPath()).data.pageAccess.studio :
        firestore.get(studioUserPath()).data.pageAccess.settings;
    }

    function canUseStudio() {
      return isSignedIn() &&
        firestore.exists(studioUserPath()) &&
        firestore.get(studioUserPath()).data.active == true &&
        studioPermission() in [
          "view", "propose", "edit", "approve", "admin"
        ];
    }

    function canManageStudioLogoLibrary() {
      return isSignedIn() &&
        firestore.exists(studioUserPath()) &&
        firestore.get(studioUserPath()).data.active == true &&
        firestore.get(studioUserPath()).data.pageAccess.studio == "admin";
    }

    function canUseStudioProject(projectId) {
      return isSignedIn() &&
        (
          firestore.get(projectPath(projectId)).data.ownerUid == request.auth.uid ||
          (
            firestore.exists(membershipPath(projectId)) &&
            firestore.get(membershipPath(projectId)).data.memberUid == request.auth.uid &&
            firestore.get(membershipPath(projectId)).data.permission == "edit"
          )
        );
    }

    // Bulletin images are written only by the permission-checked Admin API.
    // The generated Firebase download token is used by the print renderer.
    match /bulletin-mode/{allPaths=**} {
      allow read, write: if false;
    }

    match /studio-projects/{projectId}/{assetId} {
      allow read: if canUseStudioProject(projectId);
      allow create, update: if canUseStudioProject(projectId) &&
        (
          (
            assetId.matches("^logo-.*$") &&
            request.resource.size < 4 * 1024 * 1024
          ) ||
          (
            !assetId.matches("^logo-.*$") &&
            request.resource.size < 8 * 1024 * 1024
          )
        ) &&
        request.resource.contentType.matches("image/(jpeg|png|webp)");
      allow delete: if canUseStudioProject(projectId);
    }

    match /studio-library/logos/{logoId}/{fileName} {
      allow read: if canUseStudio();
      allow create: if canManageStudioLogoLibrary() &&
        resource == null &&
        !firestore.exists(logoMetadataPath(logoId)) &&
        logoId.matches("^[A-Za-z0-9_-]{1,80}$") &&
        fileName.matches("^source[.](jpg|png|webp)$") &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches("image/(jpeg|png|webp)");
      allow update: if false;
      allow delete: if canManageStudioLogoLibrary() &&
        !firestore.exists(logoMetadataPath(logoId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
